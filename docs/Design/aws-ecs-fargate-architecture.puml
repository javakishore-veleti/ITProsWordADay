@startuml AWS ECS Fargate Architecture - IT Pros WordADay

!include <awslib/AWSCommon>
!include <awslib/AWSSimplified>

!include <awslib/General/Users>
!include <awslib/General/Internet>

!include <awslib/NetworkingContentDelivery/ElasticLoadBalancingApplicationLoadBalancer>
!include <awslib/NetworkingContentDelivery/VPCInternetGateway>

!include <awslib/Containers/ElasticContainerService>
!include <awslib/Containers/ElasticContainerRegistry>
!include <awslib/Containers/Fargate>

!include <awslib/ManagementGovernance/CloudWatch>
!include <awslib/ManagementGovernance/CloudFormation>

!include <awslib/SecurityIdentityCompliance/IdentityandAccessManagement>

title IT Pros WordADay — AWS ECS Fargate Architecture

' ── External ──
Users(users, "End Users", "Browser")
Internet(internet, "Internet", "")

' ── CI/CD ──
rectangle "**CI/CD Pipeline**" as cicd #E8F5E9 {
  rectangle "GitHub Repository" as github #FFFFFF
  rectangle "GitHub Actions\nWorkflow 05" as gha #FFFFFF
}

' ── AWS ──
rectangle "**AWS Region**" as region #F5F5F5 {

  IdentityandAccessManagement(iam, "IAM", "OIDC Federation")
  CloudFormation(cfn, "CloudFormation", "ecs-stack")
  ElasticContainerRegistry(ecr, "ECR", "itpros-wordaday")
  CloudWatch(cw, "CloudWatch Logs", "/ecs/itpros-wordaday")

  rectangle "**VPC  10.1.0.0/16**" as vpc #E3F2FD {

    VPCInternetGateway(igw, "Internet Gateway", "")

    rectangle "**AZ-A — Public Subnet 10.1.0.0/20**" as az1 #E8F5E9 {
      ElasticLoadBalancingApplicationLoadBalancer(alb, "ALB", "HTTP :80/:443")
      Fargate(task1, "Fargate Task", "Go + Next.js :8080")
    }

    rectangle "**AZ-B — Public Subnet 10.1.16.0/20**" as az2 #E8F5E9 {
      Fargate(task2, "Fargate Task", "Go + Next.js :8080")
    }

    ElasticContainerService(ecs, "ECS Cluster", "itpros-wordaday-cluster")
  }
}

' ── CI/CD Flow ──
github -down-> gha : "workflow_dispatch"
gha -down-> iam : "OIDC AssumeRole"
gha -down-> ecr : "docker push"
gha -down-> cfn : "deploy stack"
gha -down-> ecs : "update service"

' ── Infra Creation ──
cfn ..> vpc : <<creates>>

' ── Traffic Flow ──
users -down-> internet
internet -down-> igw
igw -down-> alb : "HTTP"
alb -down-> task1 : ":8080"
alb -down-> task2 : ":8080"

' ── Container Mgmt ──
ecs --> task1 : manages
ecs --> task2 : manages
ecr --> task1 : image
ecr --> task2 : image
task1 --> cw : logs
task2 --> cw : logs

legend right
  |= Security Group |= Inbound |
  | ALB SG | 80, 443 from 0.0.0.0/0 |
  | Task SG | 8080 from ALB SG only |
  ---
  |= Container |= Value |
  | Runtime | Go backend + Next.js static |
  | Port | 8080 |
  | Health | GET /api/health |
  | CPU / Mem | 0.25 vCPU / 512 MB |
  ---
  |= Auth |= Method |
  | GitHub to AWS | OIDC (no static keys) |
endlegend

@enduml
